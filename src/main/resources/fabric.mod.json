{
	"schemaVersion": 1,
	"id": "tweakeroo_freecam_plus",
	"version": "${version}",
	"name": "Tweakeroo Freecam Plus",
	"description": "Adds waypoints, an adjustable sprint speed and a pointer back to your character to Tweakeroo's free camera. Middle-click sets or removes a waypoint, Ctrl + mouse wheel changes the sprint speed, and a triple tap on Ctrl points at your character.",
	"authors": [
		"Autyism"
	],
	"contact": {
		"homepage": "https://github.com/Autyism/TweakerooFreecamPlus",
		"sources": "https://github.com/Autyism/TweakerooFreecamPlus",
		"issues": "https://github.com/Autyism/TweakerooFreecamPlus/issues"
	},
	"license": "GPL-3.0-only",
	"icon": "assets/tweakeroo_freecam_plus/icon.png",
	"environment": "client",
	"entrypoints": {
		"client": [
			"io.github.autyism.freecamplus.FreecamPlus"
		]
	},
	"mixins": [
		"freecamplus.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.17.0",
		"minecraft": "1.21.11",
		"java": ">=21",
		"fabric-api": "*",
		"tweakeroo": "0.27.15"
	}
}
